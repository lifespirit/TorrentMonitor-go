[Unit]
Description=TorrentMonitor Chromium in Weston Headless
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

Environment=XDG_RUNTIME_DIR=%t/torrentmonitor-weston

ExecStartPre=/usr/bin/install -d -m 0700 %t/torrentmonitor-weston
ExecStartPre=-/usr/bin/rm -f %t/torrentmonitor-weston/wayland-headless
ExecStartPre=-/usr/bin/rm -f %t/torrentmonitor-weston/wayland-headless.lock

ExecStart=/usr/bin/weston \
    --backend=headless \
    --socket=wayland-headless \
    --width=1920 \
    --height=1080 \
    --renderer=pixman \
    --idle-time=0 \
    -- \
    /usr/bin/env WAYLAND_DEBUG=client \
    /usr/bin/chromium \
        --remote-debugging-address=127.0.0.1 \
        --remote-debugging-port=9222 \
        --user-data-dir=%h/.local/share/torrentmonitor-go/browser/torrentmonitor \
        --no-first-run \
        --no-default-browser-check \
        --ozone-platform=wayland \
        about:blank

Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
